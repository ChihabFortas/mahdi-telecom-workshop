rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function prof() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)) && prof().active == true; }
    function anyOf(rs) { return active() && prof().role in rs; }
    // Bootstrap owner(s): same email(s) as ADMINS in firebase-config.js
    function isOwner() { return signedIn() && request.auth.token.email in ['owner@example.com']; }
    function staff() { return anyOf(['reception','technician','inventory','manager','admin']); }
    function front() { return anyOf(['reception','manager','admin']); }
    function boss()  { return anyOf(['manager','admin']); }
    function onlyKeys(k) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(k); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || boss());
      allow create: if (isOwner() && request.auth.uid == uid) || anyOf(['admin']);
      allow update: if anyOf(['admin']) || (isOwner() && request.auth.uid == uid);
      allow delete: if anyOf(['admin']);
    }
    match /tickets/{id} {
      allow read: if front() || anyOf(['inventory']) || (anyOf(['technician']) && (resource.data.techId == request.auth.uid || resource.data.repairedBy == request.auth.uid));
      allow create: if front();
      allow update: if front()
        || (anyOf(['technician']) && resource.data.techId == request.auth.uid && onlyKeys(['status','items','services','history','updatedAt','pendingQuote','noRepair','repairedBy','repairedByName','repairedAt','repairLevel']))
        || (anyOf(['inventory']) && onlyKeys(['items','updatedAt']));
      allow delete: if boss();
    }
    match /technicians/{id} { allow read: if staff(); allow write: if anyOf(['admin']); }
    match /settings/{id} { allow read: if staff(); allow write: if anyOf(['admin']); }
    // Public tracking: customers can fetch ONE document by code/phone, never list them
    match /tracking/{id}      { allow get: if true; allow list: if false; allow write: if staff(); }
    match /trackingPhone/{id} { allow get: if true; allow list: if false; allow write: if staff(); }
    match /customers/{id} { allow read, write: if front(); }
    match /payments/{id} {
      allow read, create: if front();
      allow delete: if anyOf(['admin']) && resource.data.demo == true;
    }
    match /parts/{id} {
      allow read: if staff();
      allow create, delete: if boss();
      allow update: if boss() || (staff() && onlyKeys(['qty']));
    }
    match /products/{id} {
      allow read: if staff();
      allow create, delete: if boss();
      allow update: if boss() || (staff() && onlyKeys(['qty']));
    }
    match /movements/{id} {
      allow read, create: if staff();
      allow delete: if anyOf(['admin']) && resource.data.demo == true;
    }
    match /receivings/{id} { allow read: if staff(); allow write: if boss(); }
    match /deliveries/{id} {
      allow read, create: if front();
      allow update, delete: if anyOf(['admin']);
    }
    match /registers/{id} { allow read: if front(); allow write: if boss(); }
    match /cashEntries/{id} { allow read: if boss(); allow create: if front(); allow update, delete: if boss(); }
    match /expenses/{id} {
      allow read: if boss() && (resource.data.adminOnly == false || anyOf(['admin']));
      allow create: if boss();
      allow update, delete: if boss() && (resource.data.adminOnly == false || anyOf(['admin']));
    }
    match /losses/{id} { allow read, write: if boss(); }
    match /dayClosings/{id} {
      allow read, create: if boss();
      allow update: if boss() && (resource.data.locked != true || anyOf(['admin']));
      allow delete: if anyOf(['admin']);
    }
    match /suppliers/{id} { allow read: if boss() || anyOf(['inventory']); allow write: if boss(); }
    match /supplierPayments/{id} { allow read, create: if boss(); allow update, delete: if anyOf(['admin']); }
    match /returns/{id} { allow read, create: if front(); allow update, delete: if anyOf(['admin']); }
    match /counters/{id} { allow read, write: if front() || anyOf(['inventory']); }
    match /partNeeds/{id} { allow read, create: if staff(); allow update: if anyOf(['inventory','reception','manager','admin']); allow delete: if boss(); }
    match /purchaseOrders/{id} { allow read, create, update: if boss() || anyOf(['inventory']); allow delete: if anyOf(['admin']); }
    match /invoices/{id} {
      allow read: if boss() || (front() && resource.data.partyType == 'customer');
      allow create: if boss() || (front() && request.resource.data.partyType == 'customer');
      allow update: if boss();
      allow delete: if anyOf(['admin']);
    }
    match /stockCounts/{id} {
      allow read, create, update: if boss();
      allow delete: if anyOf(['admin']);
      match /lines/{l} { allow read, write: if boss(); }
    }
    match /priceLog/{id} { allow read, create: if boss(); }
    match /feedback/{id} {
      allow read: if staff();
      allow create: if request.resource.data.keys().hasOnly(['code','rating','comment','createdAt']) && request.resource.data.code == id && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 && request.resource.data.comment is string && request.resource.data.comment.size() <= 500 && request.resource.data.createdAt == request.time && exists(/databases/$(db)/documents/tracking/$(id));
      allow update, delete: if anyOf(['admin']);
    }
    match /heldSales/{id} { allow read, write: if front(); }
    match /audit/{id} { allow read: if boss(); allow create: if staff(); }
  }
}
